<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:background="@color/zx_white"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/native_icon_simple3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/native_title_simple3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/zx_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/native_price_simple3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/zx_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/native_rating_simple3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/zx_text_hint"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
